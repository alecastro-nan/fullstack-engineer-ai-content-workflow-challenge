# ── Database ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acme
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=acme

# ── Frontend (dev only; production uses nginx proxy) ──
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ── AI Providers (at least one required) ──
# OpenAI (also works with OpenAI-compatible APIs like OpenRouter)
OPENAI_API_KEY=sk-or-your-openrouter-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=gpt-4o

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ── App ──
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=your-secret-key-here
PORT=8000
FRONTEND_URL=http://localhost:5173,http://staging.example.com
DEBUG=True

# ── Production (override in prod) ──
# ALLOWED_HOSTS=example.com,www.example.com
# CSRF_TRUSTED_ORIGINS=https://example.com

# ── Auth ──
AUTH_REQUIRED=True
# JWT_SIGNING_KEY=separate-key-for-jwt-signing

# ── Redis (optional, for async/queues) ──
REDIS_URL=redis://localhost:6379
